{
  "expo": {
    "name": "Trova",
    "slug": "trova",
    "version": "1.0.0",
    "scheme": "trova",
    "orientation": "portrait",
    "icon": "./icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f1726"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#000000"
      },
      "package": "kkadogo.findstreamer.com",
      "usesCleartextTraffic": false
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Trova to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow Trova to convert speech into search text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
      }
    },
    "owner": "kkadogo"
  }
}